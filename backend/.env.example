# Server
PORT=3001
NODE_ENV=development

# PostgreSQL (matches docker-compose)
DATABASE_URL="postgresql://reachinbox:reachinbox_secret@localhost:5432/reachinbox"

# Redis (matches docker-compose)
REDIS_HOST=localhost
REDIS_PORT=6379

# Elasticsearch (matches docker-compose)
ELASTICSEARCH_URL=http://localhost:9200

# Session
SESSION_SECRET=change_me_to_a_long_random_string_in_production

# Google OAuth 2.0
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Frontend URL (for CORS + OAuth redirects)
FRONTEND_URL=http://localhost:3000

# Slack OAuth
# Create a Slack app at: https://api.slack.com/apps
# Required scopes: incoming-webhook, chat:write
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_REDIRECT_URI=http://localhost:3001/api/slack/callback

# Rate Limiting
MAX_EMAILS_PER_HOUR=100
MIN_DELAY_BETWEEN_SENDS_MS=1000

# BullMQ Worker
WORKER_CONCURRENCY=5
